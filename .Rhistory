library(crqa)
# ---- Load aligned trials ----
d <- read.csv("ball_aligned_all.csv")
# ---- Load aligned trials ----
d <- read.csv("ball_aligned_all.csv")
trials <- unique(d$trial)
cat("Trials available:", paste(trials, collapse = ", "), "\n")
# Hold out one trial
held_out <- "T0001"
others   <- setdiff(trials, held_out)
# Average path from the other trials (pointwise)
avg_path <- aggregate(cbind(X, Y, Z) ~ point,
data = d[d$trial %in% others, ],
FUN = mean)
avg_path <- avg_path[order(avg_path$point), c("X", "Y", "Z")]
avg_path <- as.matrix(avg_path)
# Held-out trial
held <- d[d$trial == held_out, c("X", "Y", "Z")]
held <- as.matrix(held[order(d$point[d$trial == held_out]), ])
cat("Average path points:", nrow(avg_path), "\n")
cat("Held-out points:", nrow(held), "\n")
# ---- Residual = Euclidean distance to corresponding point on average path ----
# (simple pointwise residual; for a true path residual you can later project onto segments)
residual <- sqrt(rowSums((held - avg_path)^2))
# ---- Progress along the average path (arc-length style) ----
# Cumulative distance along the average path, then interpolate for the held-out points
path_steps <- sqrt(rowSums(diff(avg_path)^2))
path_s     <- c(0, cumsum(path_steps))          # arc-length parameter of average path
# For the held-out trial, use the same normalized index as a first approximation
progress   <- path_s
# ---- RQA helper ----
run_rqa <- function(series) {
rad <- 0.01 * diff(range(series))
crqa(series, series,
delay = 1, embed = 1, rescale = 0, radius = rad,
normalize = 0, mindiagline = 2, minvertline = 2,
tw = 5, method = "rqa", metric = "euclidean",
datatype = "continuous")
}
# Arbitrary axes on the held-out trial
rqa_X <- run_rqa(held[, 1])
rqa_Y <- run_rqa(held[, 2])
rqa_Z <- run_rqa(held[, 3])
# Task-aligned
rqa_prog <- run_rqa(progress)
rqa_res  <- run_rqa(residual)
cat("\n=== Held-out trial", held_out, "===\n")
cat("Arbitrary X  RR:", round(rqa_X$RR, 2), " DET:", round(rqa_X$DET, 1), " maxL:", rqa_X$maxL, "\n")
cat("Arbitrary Y  RR:", round(rqa_Y$RR, 2), " DET:", round(rqa_Y$DET, 1), " maxL:", rqa_Y$maxL, "\n")
cat("Arbitrary Z  RR:", round(rqa_Z$RR, 2), " DET:", round(rqa_Z$DET, 1), " maxL:", rqa_Z$maxL, "\n")
cat("Progress     RR:", round(rqa_prog$RR, 2), " DET:", round(rqa_prog$DET, 1), " maxL:", rqa_prog$maxL, "\n")
cat("Residual     RR:", round(rqa_res$RR, 2), " DET:", round(rqa_res$DET, 1), " maxL:", rqa_res$maxL, "\n")
# Plots
op <- par(mfrow = c(2, 2))
plot(held[, 1], type = "l", main = "Held-out X", ylab = "ft")
lines(avg_path[, 1], col = "red", lty = 2)
plot(held[, 3], type = "l", main = "Held-out Z", ylab = "ft")
lines(avg_path[, 3], col = "red", lty = 2)
plot(progress, type = "l", main = "Progress along avg path")
plot(residual, type = "l", main = "Residual to avg path", ylab = "ft")
par(op)
