# RQA helper
run_rqa <- function(series) {
rad <- 0.01 * diff(range(series))
crqa(series, series,
delay = 1, embed = 1, rescale = 0, radius = rad,
normalize = 0, mindiagline = 2, minvertline = 2,
tw = 5, method = "rqa", metric = "euclidean",
datatype = "continuous")
}
