# ---- Load cleaned ball trajectory (feet) ----
xyz <- as.matrix(read.csv("ball_xyz.csv"))
colnames(xyz) <- c("X", "Y", "Z")
cat("Valid ball frames:", nrow(xyz), "\n")
# ---- RQA settings (same style as your Example 1) ----
delay       <- 1
embed       <- 1
rescale     <- 0
normalize   <- 0
mindiagline <- 2
minvertline <- 2
tw          <- 5
method      <- "rqa"
metric      <- "euclidean"
datatype    <- "continuous"
run_rqa <- function(series) {
rad <- 0.01 * diff(range(series))
crqa(series, series,
delay = delay, embed = embed,
rescale = rescale, radius = rad,
normalize = normalize,
mindiagline = mindiagline, minvertline = minvertline,
tw = tw, method = method, metric = metric,
datatype = datatype)
}
rqa_X <- run_rqa(xyz[, "X"])
rqa_Y <- run_rqa(xyz[, "Y"])
rqa_Z <- run_rqa(xyz[, "Z"])
cat("\n=== Arbitrary court axes (1% range) ===\n")
cat("X  RR:", round(rqa_X$RR, 2), "  DET:", round(rqa_X$DET, 1), "  maxL:", rqa_X$maxL, "\n")
cat("Y  RR:", round(rqa_Y$RR, 2), "  DET:", round(rqa_Y$DET, 1), "  maxL:", rqa_Y$maxL, "\n")
cat("Z  RR:", round(rqa_Z$RR, 2), "  DET:", round(rqa_Z$DET, 1), "  maxL:", rqa_Z$maxL, "\n")
start <- xyz[1, ]
end   <- xyz[nrow(xyz), ]
dir   <- end - start
dir   <- dir / sqrt(sum(dir^2))
progress <- as.numeric((xyz - start) %*% dir)
cross <- function(a, b) {
c(a[2]*b[3] - a[3]*b[2],
a[3]*b[1] - a[1]*b[3],
a[1]*b[2] - a[2]*b[1])
}
residuals <- apply(xyz, 1, function(p) {
sqrt(sum(cross(p - start, dir)^2))
})
rqa_prog <- run_rqa(progress)
rqa_res  <- run_rqa(residuals)
cat("\n=== Task-aligned (progress vs residual) ===\n")
cat("Progress RR:", round(rqa_prog$RR, 2), "  DET:", round(rqa_prog$DET, 1),
"  maxL:", rqa_prog$maxL, "\n")
cat("Residual RR:", round(rqa_res$RR, 2),  "  DET:", round(rqa_res$DET, 1),
"  maxL:", rqa_res$maxL, "\n")
# Optional plots of the series
op <- par(mfrow = c(2, 2))
plot(xyz[, "X"], type = "l", main = "Arbitrary X (court)", ylab = "ft")
# Optional plots of the series
op <- par(mfrow = c(2, 2))
plot(xyz[, "X"], type = "l", main = "Arbitrary X (court)", ylab = "ft")
plot(xyz[, "Z"], type = "l", main = "Arbitrary Z (height)", ylab = "ft")
plot(progress, type = "l", main = "Progress along ideal line", ylab = "ft")
plot(residuals, type = "l", main = "Residual distance to line", ylab = "ft")
par(op)
range(progress)
plot(xyz)
plot(xyz[,1])
plot(xyz[,2])
plot(xyz[,3])
xyz <- as.matrix(read.csv("ball_xyz.csv"))
colnames(xyz) <- c("X", "Y", "Z")
# ---- Restrict to the progressive free-flight portion ----
# In this trial the ball reaches min X then rises toward the hoop
idx_start <- which.min(xyz[, "X"])
xyz_flight <- xyz[idx_start:nrow(xyz), ]
cat("Flight frames:", nrow(xyz_flight), "\n")
# ---- RQA helper (unchanged) ----
run_rqa <- function(series) {
rad <- 0.01 * diff(range(series))
crqa(series, series,
delay = 1, embed = 1, rescale = 0, radius = rad,
normalize = 0, mindiagline = 2, minvertline = 2,
tw = 5, method = "rqa", metric = "euclidean",
datatype = "continuous")
}
# =============================================================================
# 1. Arbitrary axes on the flight segment
# =============================================================================
rqa_X <- run_rqa(xyz_flight[, "X"])
rqa_Y <- run_rqa(xyz_flight[, "Y"])
rqa_Z <- run_rqa(xyz_flight[, "Z"])
cat("\n=== Arbitrary axes on flight segment ===\n")
cat("X  RR:", round(rqa_X$RR, 2), " DET:", round(rqa_X$DET, 1), " maxL:", rqa_X$maxL, "\n")
cat("Y  RR:", round(rqa_Y$RR, 2), " DET:", round(rqa_Y$DET, 1), " maxL:", rqa_Y$maxL, "\n")
cat("Z  RR:", round(rqa_Z$RR, 2), " DET:", round(rqa_Z$DET, 1), " maxL:", rqa_Z$maxL, "\n")
# =============================================================================
# 2. Task-aligned on the flight segment
#    Ideal direction = unit vector from first to last point of the segment
# =============================================================================
start <- xyz_flight[1, ]
end   <- xyz_flight[nrow(xyz_flight), ]
dir   <- end - start
dir   <- dir / sqrt(sum(dir^2))
progress <- as.numeric((xyz_flight - start) %*% dir)
cross <- function(a, b) {
c(a[2]*b[3] - a[3]*b[2],
a[3]*b[1] - a[1]*b[3],
a[1]*b[2] - a[2]*b[1])
}
residuals <- apply(xyz_flight, 1, function(p) {
sqrt(sum(cross(p - start, dir)^2))
})
rqa_prog <- run_rqa(progress)
rqa_res  <- run_rqa(residuals)
cat("\n=== Task-aligned on flight segment ===\n")
cat("Progress range:", round(range(progress), 2), "\n")
cat("Progress RR:", round(rqa_prog$RR, 2), " DET:", round(rqa_prog$DET, 1),
" maxL:", rqa_prog$maxL, "\n")
cat("Residual RR:", round(rqa_res$RR, 2), " DET:", round(rqa_res$DET, 1),
" maxL:", rqa_res$maxL, "\n")
# Optional: pure court-aligned progressive coordinate (-X)
progress_court <- -xyz_flight[, "X"]
rqa_court_prog <- run_rqa(progress_court)
cat("\nCourt-aligned progress (-X) RR:", round(rqa_court_prog$RR, 2),
" DET:", round(rqa_court_prog$DET, 1), " maxL:", rqa_court_prog$maxL, "\n")
# Plots
op <- par(mfrow = c(2, 2))
plot(xyz_flight[, "X"], type = "l", main = "Flight X")
plot(xyz_flight[, "Z"], type = "l", main = "Flight Z")
plot(progress, type = "l", main = "Progress (start→end of flight)")
plot(residuals, type = "l", main = "Residual to flight line")
par(op)
