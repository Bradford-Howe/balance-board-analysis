"Frc4","copX","copY","FrcTot")
PlotFileName = paste0(i,".png")
thisX = CurrentData$copX
thisY = CurrentData$copY
maxX = ceiling(length(thisX) / 500) * 500
minY = min(c(thisX,thisY)) - 5
maxY = max(c(thisX,thisY)) + 5
png(PlotFileName,
width = 800 + maxX/5,
height = 1000 )
par(mar = c(5, 6, 4, 2) + 0.1)
plot(thisX,
cex = 2,
main = PlotFileName,
cex.main = 3,
sub = "Note: Horizontal lines are means",
cex.sub = 3,
xlab = '',
ylab = "COP X & Y",
cex.lab = 3,
type = 'p',
xlim = c(0,maxX),
ylim = c(minY,maxY),
cex.axis = 2,
pch = 16,
frame.plot = F,
col = terrain.colors(9)
)
points(thisY,
pch = 16,
cex = 2,
col = grey.colors(9))
abline(h = mean(thisX),
col = terrain.colors(9)[5],
lw = 2)
abline(h = mean(thisY),
col = 'grey',
lw = 2)
legend('topright',
c("COP X", "COP Y"),
cex = 2,
col = c(terrain.colors(9)[5],'grey'),
pch = 16
)
# Close plotting device
dev.off()
par(mar = c(5, 4, 4, 2) + 0.1)
dev.set(NormalGraphicDevice)
}
dev.off()
}
