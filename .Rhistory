setwd("C:/RprojectsFoyer/BalanceBoardAnalysis")
load("C:/RprojectsFoyer/BalanceBoardAnalysis/.RData")
library(crqa)
delay = 4
embed = 10
radius = 0.10          # 10% after mean-distance rescaling
rescale = 1            # 1 = divide distances by the mean distance
normalize = 0          # raw (demeaned) millimetres; set to 2 to z-score
mindiagline = 2
minvertline = 2
tw = 1                 # drop the line of identity from the measures
metric = "euclidean"
datatype = "continuous"
demean = function(z) {
z = as.numeric(z)
z - mean(z, na.rm = TRUE)
}
# Webber-style TREND: slope of % recurrence vs distance from the
# line of identity. More negative = faster drift / less stationary.
webber_trend = function(RP, max_percent = 50) {
RP = as.matrix(RP)
storage.mode(RP) = "numeric"
n = nrow(RP)
max_k = max(2, floor(n * max_percent / 100))
k = 1:max_k
rec_k = sapply(k, function(d) {
100 * mean(RP[row(RP) == (col(RP) + d)])
})
unname(coef(lm(rec_k ~ k))[2])
}
run_rqa_one = function(z, label) {
z = demean(z)
z = z[is.finite(z)]
ans = crqa(
ts1 = z,
ts2 = z,
delay = delay,
embed = embed,
rescale = rescale,
radius = radius,
normalize = normalize,
mindiagline = mindiagline,
minvertline = minvertline,
tw = tw,
whiteline = FALSE,
recpt = FALSE,
side = "both",
method = "rqa",
metric = metric,
datatype = datatype
)
list(
label = label,
n = length(z),
RR = ans$RR,
DET = ans$DET,
ENTR = ans$ENTR,
L = ans$L,
TREND = webber_trend(ans$RP),
RP = ans$RP
)
}
plot_recurrence = function(RP, main = "") {
RP = as.matrix(RP)
storage.mode(RP) = "numeric"
# image() draws the first row at the bottom, so this matches
# Fig. 3 (origin at lower left; i on x, j on y).
image(
x = seq_len(nrow(RP)),
y = seq_len(ncol(RP)),
z = RP,
col = c("white", "black"),
xlab = "i index",
ylab = "j index",
main = main,
useRaster = TRUE,
axes = TRUE
)
}
# ---- one trial first, so you can see the plot before looping ----
trial_name = names(trial_list)[1]
trial = trial_list[[trial_name]]
rqa_x = run_rqa_one(trial$copX, paste(trial_name, "X"))
rqa_y = run_rqa_one(trial$copY, paste(trial_name, "Y"))
print(data.frame(
series = c(rqa_x$label, rqa_y$label),
n = c(rqa_x$n, rqa_y$n),
pct_rec = c(rqa_x$RR, rqa_y$RR),
pct_det = c(rqa_x$DET, rqa_y$DET),
entropy = c(rqa_x$ENTR, rqa_y$ENTR),
trend = c(rqa_x$TREND, rqa_y$TREND)
))
op = par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
plot_recurrence(rqa_x$RP, main = rqa_x$label)
plot_recurrence(rqa_y$RP, main = rqa_y$label)
par(op)
save.image("C:/RprojectsFoyer/BalanceBoardAnalysis/RMS_RQA.RData")
